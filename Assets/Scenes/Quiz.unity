MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1603242855}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6f093f2e633a1c4e8e0970dca39a0cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  difficulty: 0
  questionlist:
  - question:
    - 'Sebuah kelas mempunyai 36 murid. Guru membahagikan murid kepada kumpulan yang
      sama banyak dengan 6 orang setiap kumpulan. Berapakah bilangan kumpulan terbentuk? '
    QuestionOnAnswersBtn:
    - answer:
      - Jumlah murid = 36
      - Setiap kumpulan = 6 murid
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - Tambah (+)
      - Tolak (-)
      - "Bahagi (\xF7)"
      answeOnBtn: 2
    - answer:
      - "36 \xF7 6 = 5"
      - "36 \xF7 6 = 6"
      - "36 \xF7 6 = 7"
      answeOnBtn: 1
    - answer:
      - "6 \xD7 6 = 36"
      - "5 \xD7 6 = 36"
      - "7 \xD7 6 = 36"
      answeOnBtn: 0
    - answer:
      - 'Bilangan kumpulan terbentuk ialah 7 kumpulan. '
      - 'Bilangan kumpulan terbentuk ialah 6 kumpulan. '
      answeOnBtn: 0
  - question:
    - 'Sebuah perpustakaan membeli 24 buku matematik dengan harga RM12 setiap satu.
      Berapakah jumlah kos yang dibayar perpustakaan itu? '
    QuestionOnAnswersBtn:
    - answer:
      - Bilangan buku = 24
      - Harga setiap buku = RM12
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - Tolak (-)
      - Tambah (+)
      - "Darab (\xD7)"
      answeOnBtn: 2
    - answer:
      - "24 \xD7 RM12 = RM288"
      - "24 \xD7 RM12 = RM268"
      - "24 \xD7 RM12 = RM250"
      answeOnBtn: 0
    - answer:
      - "RM288 \xF7 24 = RM12"
      - RM288 + 24 = RM312
      - "RM288 \u2212 12 = RM276"
      answeOnBtn: 0
    - answer:
      - 'Jumlah kos buku ialah RM288. '
      - 'Jumlah kos buku ialah RM300. '
      answeOnBtn: 1
  - question:
    - 'Sebuah tangki air mengandungi 125 liter air. 48 liter digunakan untuk menyiram
      pokok. Berapakah baki air dalam tangki itu? '
    QuestionOnAnswersBtn:
    - answer:
      - Jumlah air = 125 liter
      - Air digunakan = 48 liter
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - 'Tambah (+) '
      - Tolak (-)
      - "Darab (\xD7)"
      answeOnBtn: 1
    - answer:
      - "125 \u2212 48 = 77"
      - "125 \u2212 48 = 78"
      - "125 \u2212 48 = 79"
      answeOnBtn: 0
    - answer:
      - 77 + 48 = 125
      - "125 \u2212 77 = 48"
      - Kedua-duanya betul
      answeOnBtn: 2
    - answer:
      - 'Baki air dalam tangki ialah 77 liter. '
      - 'Baki air dalam tangki ialah 75 liter. '
      answeOnBtn: 0
  - question:
    - 'Ali berbasikal sejauh 12.5 km pada waktu pagi dan 8.75 km pada waktu petang.
      Berapakah jumlah jarak yang dilalui Ali dalam sehari? '
    QuestionOnAnswersBtn:
    - answer:
      - Jarak pagi = 12.5 km
      - Jarak petang = 8.75 km
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - Tambah (+)
      - Tolak (-)
      - "Darab (\xD7)"
      answeOnBtn: 0
    - answer:
      - 12.5 + 8.75 = 20.25 km
      - 12.5 + 8.75 = 21.25 km
      - 12.5 + 8.75 = 22.25 km
      answeOnBtn: 0
    - answer:
      - "20.25 \u2212 12.5 = 8.75"
      - "20.25 \u2212 8.75 = 12.5"
      - Kedua-duanya betul
      answeOnBtn: 2
    - answer:
      - 'Jumlah jarak yang dilalui Ali ialah 20.35 km. '
      - 'Jumlah jarak yang dilalui Ali ialah 20.25 km. '
      answeOnBtn: 1
  - question:
    - 'Sebuah sekolah mengutip 96 kg botol plastik untuk kitar semula. Jika setiap
      guni boleh memuatkan 12 kg, berapakah bilangan guni diperlukan? '
    QuestionOnAnswersBtn:
    - answer:
      - Jumlah botol plastik = 96 kg
      - Setiap guni = 12 kg
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - Tambah (+)
      - Tolak (-)
      - "Bahagi (\xF7)"
      answeOnBtn: 0
    - answer:
      - "96 \xF7 12 = 8"
      - "96 \xF7 12 = 7"
      - "96 \xF7 12 = 6"
      answeOnBtn: 0
    - answer:
      - "8 \xD7 12 = 96"
      - "7 \xD7 12 = 96"
      - "6 \xD7 12 = 96"
      answeOnBtn: 0
    - answer:
      - 'Bilangan guni yang diperlukan ialah 8 guni. '
      - 'Bilangan guni yang diperlukan ialah 10 guni. '
      answeOnBtn: 0
