MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 846102237}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6f093f2e633a1c4e8e0970dca39a0cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  difficulty: 0
  questionlist:
  - question:
    - 'Sebuah sekolah mengumpul 256 botol plastik pada minggu pertama, 348 botol
      pada minggu kedua dan 415 botol pada minggu ketiga. Berapakah jumlah botol
      plastik yang dikumpulkan dalam tiga minggu? '
    QuestionOnAnswersBtn:
    - answer:
      - Minggu pertama = 256
      - Minggu kedua = 348
      - 'Minggu ketiga = 415 '
      - Semua di atas
      answeOnBtn: 3
    - answer:
      - Tambah (+)
      - Tolak (-)
      - "Darab (\xD7)"
      answeOnBtn: 0
    - answer:
      - 256 + 348 + 415 = 1019
      - 256 + 348 + 415 = 1009
      - 256 + 348 + 415 = 999
      answeOnBtn: 0
    - answer:
      - "1019 \u2212 256 \u2212 348 \u2212 415 = 0 "
      - 1019 + 10 = 1029
      - "1019 \u2212 256 = 763"
      answeOnBtn: 0
    - answer:
      - 'Jumlah botol plastik yang dikumpulkan ialah 1019 botol. '
      - 'Jumlah botol plastik yang dikumpulkan ialah 1016 botol. '
      answeOnBtn: 0
  - question:
    - 'Harga sebuah komputer riba ialah RM2 350. Sekolah membeli 8 buah komputer
      riba. Berapakah jumlah kos yang perlu dibayar sekolah itu? '
    QuestionOnAnswersBtn:
    - answer:
      - Harga sebuah komputer = RM2350
      - Bilangan komputer = 8
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - "Darab (\xD7)"
      - Tambah (+)
      - Tolak (-)
      answeOnBtn: 0
    - answer:
      - "2350 \xD7 8 = RM18 800 "
      - "2350 \xD7 8 = RM18 600"
      - "2350 \xD7 8 = RM18 000"
      answeOnBtn: 0
    - answer:
      - "RM18 800 \xF7 8 = RM2350"
      - 'RM18 800 + 2350 = RM21 150 '
      - "RM18 800 \u2212 8 = RM18 792"
      answeOnBtn: 0
    - answer:
      - 'Jumlah kos komputer riba ialah RM18 800. '
      - 'Jumlah kos komputer riba ialah RM16 200. '
      answeOnBtn: 0
  - question:
    - 'Sebuah kereta bergerak sejauh 360 km dalam masa 6 jam. Berapakah purata laju
      kereta itu dalam km/j? '
    QuestionOnAnswersBtn:
    - answer:
      - Jarak = 360 km
      - Masa = 6 jam
      - 'Kedua-dua A dan B '
      answeOnBtn: 2
    - answer:
      - 'Tambah (+) '
      - Tolak (-)
      - "Darab (\xD7)"
      answeOnBtn: 0
    - answer:
      - "360 \xF7 6 = 60 km/j"
      - "360 \xF7 6 = 65 km/j"
      - "360 \xF7 6 = 55 km/j"
      answeOnBtn: 0
    - answer:
      - "60 \xD7 6 = 360"
      - "65 \xD7 6 = 390"
      - "55 \xD7 6 = 330"
      answeOnBtn: 0
    - answer:
      - 'Purata laju kereta ialah 63 km/j. '
      - 'Purata laju kereta ialah 60 km/j. '
      answeOnBtn: 1
  - question:
    - 'Sebuah kedai menjual 125 kg beras. Setiap kampit beras seberat 5 kg. Berapakah
      bilangan kampit beras yang terjual? '
    QuestionOnAnswersBtn:
    - answer:
      - Jumlah beras = 125 kg
      - Berat setiap kampit = 5 kg
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - "Bahagi (\xF7)"
      - Tambah (+)
      - Tolak (-)
      answeOnBtn: 0
    - answer:
      - "125 \xF7 5 = 20"
      - "125 \xF7 5 = 25"
      - "125 \xF7 5 = 30"
      answeOnBtn: 1
    - answer:
      - "25 \xD7 5 = 125"
      - "20 \xD7 5 = 125"
      - "30 \xD7 5 = 125"
      answeOnBtn: 0
    - answer:
      - 'Bilangan kampit beras yang terjual ialah 25 kampit. '
      - 'Bilangan kampit beras yang terjual ialah 33 kampit. '
      answeOnBtn: 0
  - question:
    - 'Sebuah bas boleh membawa 45 orang penumpang. Jika terdapat 18 buah bas, berapakah
      jumlah penumpang maksimum yang boleh dibawa? '
    QuestionOnAnswersBtn:
    - answer:
      - Kapasiti sebuah bas = 45 orang
      - Bilangan bas = 18
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - "Darab (\xD7)"
      - "Bahagi (\xF7)"
      - Tambah (+)
      answeOnBtn: 0
    - answer:
      - "45 \xD7 18 = 810"
      - "45 \xD7 18 = 820"
      - "45 \xD7 18 = 800"
      answeOnBtn: 0
    - answer:
      - "810 \xF7 18 = 45"
      - "820 \xF7 18 = 45"
      - "800 \xF7 18 = 45"
      answeOnBtn: 0
    - answer:
      - 'Jumlah penumpang maksimum ialah 810 orang. '
      - 'Jumlah penumpang maksimum ialah 825 orang. '
      answeOnBtn: 0
