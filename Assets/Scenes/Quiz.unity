  m_IsActive: 1
--- !u!114 &2105010984
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2105010983}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6f093f2e633a1c4e8e0970dca39a0cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  difficulty: 0
  questionlist:
  - question:
    - 'Aiman menjual 12 tin aluminium kepada pusat kitar semula. Setiap tin bernilai
      20 sen. Berapakah jumlah wang yang Aiman terima? '
    QuestionOnAnswersBtn:
    - answer:
      - Setiap tin bernilai 20 sen
      - Jumlah tin = 12 buah
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - Tambah (+)
      - Tolak (-)
      - "Darab (\xD7)"
      answeOnBtn: 2
    - answer:
      - "12 \xD7 20 sen = 220 sen"
      - "12 \xD7 20 sen = 240 sen"
      - "12 \xD7 20 sen = 200 sen"
      answeOnBtn: 1
    - answer:
      - "240 \xF7 12 = 20 sen"
      - 240 + 12 = 252 sen
      - "240 \u2212 20 = 220 sen"
      answeOnBtn: 0
    - answer:
      - Jumlah wang yang Aiman terima ialah RM2.40
      - Jumlah wang yang Aiman terima ialah RM2.10
      answeOnBtn: 0
  - question:
    - 'Nurul berjalan kaki ke sekolah selama 25 minit. Dia mula pukul 6:45 pagi.
      Pukul berapakah dia tiba di sekolah? '
    QuestionOnAnswersBtn:
    - answer:
      - 'Waktu mula = 6:45 pagi '
      - Tempoh masa = 25 minit
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - Tolak (-)
      - Tambah (+)
      - "Bahagi (\xF7)"
      answeOnBtn: 1
    - answer:
      - 6:45 + 25 minit = 7:05 pagi
      - 6:45 + 25 minit = 7:10 pagi
      - 6:45 + 25 minit = 7:15 pagi
      answeOnBtn: 1
    - answer:
      - "Dari 6:45 \u2192 7:00 = 15 minit, tambah 10 minit lagi = 25 minit"
      - "Dari 6:45 \u2192 7:00 = 20 minit, tambah 5 minit lagi = 25 minit"
      - Kedua-dua cara betul
      answeOnBtn: 2
    - answer:
      - 'Nurul tiba di sekolah pada 7:10 pagi. '
      - 'Nurul tiba di sekolah pada 7:30 pagi. '
      answeOnBtn: 0
  - question:
    - Dalam perpustakaan sekolah terdapat 240 buku cerita dan 180 buku rujukan. Berapakah
      jumlah semua buku?
    QuestionOnAnswersBtn:
    - answer:
      - Buku cerita = 240
      - Buku rujukan = 180
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - 'Tambah (+) '
      - Tolak (-)
      - "Bahagi (\xF7)"
      answeOnBtn: 0
    - answer:
      - 240 + 180 = 420
      - 240 + 180 = 400
      - 240 + 180 = 410
      answeOnBtn: 0
    - answer:
      - "420 \u2212 240 = 180"
      - "420 \u2212 180 = 240"
      - Kedua-duanya betul
      answeOnBtn: 2
    - answer:
      - Jumlah semua buku ialah 420 buah
      - Jumlah semua buku ialah 380 buah
      answeOnBtn: 0
  - question:
    - 'Sara mempunyai 15 batang pensel. Dia memberikan 7 batang kepada rakannya.
      Berapakah bilangan pensel yang masih ada pada Sara? '
    QuestionOnAnswersBtn:
    - answer:
      - Bilangan pensel Sara = 15
      - Pensel diberi = 7
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - Tambah (+)
      - Tolak (-)
      - "Darab (\xD7)"
      answeOnBtn: 1
    - answer:
      - "15 \u2212 7 = 8"
      - "15 \u2212 7 = 9"
      - "15 \u2212 7 = 7"
      answeOnBtn: 0
    - answer:
      - 8 + 7 = 15
      - 15 + 7 = 22
      - 9 + 7 = 15
      answeOnBtn: 0
    - answer:
      - Sara masih ada 8 batang pensel
      - Sara masih ada 12 batang pensel
      answeOnBtn: 0
  - question:
    - 'Sekolah menanam 18 pokok bunga di halaman kiri dan 12 pokok bunga di halaman
      kanan. Berapakah jumlah pokok bunga semuanya? '
    QuestionOnAnswersBtn:
    - answer:
      - 'Halaman kiri = 18 pokok '
      - Halaman kanan = 12 pokok
      - Kedua-dua A dan B
      answeOnBtn: 2
