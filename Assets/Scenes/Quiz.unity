  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &776928818
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 776928817}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6f093f2e633a1c4e8e0970dca39a0cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  difficulty: 0
  questionlist:
  - question:
    - 'Sebuah sekolah ingin memasang panel solar di bumbung untuk menjimatkan elektrik.
      Jika sebuah panel menghasilkan 250 kWh sebulan dan sekolah memerlukan 3000
      kWh sebulan, berapakah bilangan panel solar minimum yang diperlukan? '
    QuestionOnAnswersBtn:
    - answer:
      - Sebuah panel = 250 kWh
      - 'Keperluan sekolah = 3000 kWh '
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - "Bahagi (\xF7)"
      - Tambah (+)
      - "Tolak (\u2212)"
      answeOnBtn: 0
    - answer:
      - "3000 \xF7 250 = 12"
      - "3000 \xF7 250 = 13"
      - "3000 \xF7 250 = 14"
      answeOnBtn: 0
    - answer:
      - "12 \xD7 250 = 3000"
      - "13 \xD7 250 = 3250"
      - "11 \xD7 250 = 2750"
      answeOnBtn: 0
    - answer:
      - 'Bilangan panel solar minimum yang diperlukan ialah 14 panel. '
      - 'Bilangan panel solar minimum yang diperlukan ialah 12 panel. '
      answeOnBtn: 1
  - question:
    - '200 murid berjanji untuk mengurangkan masa mandi daripada 10 minit kepada
      7 minit sehari. Jika setiap minit menggunakan 15 liter air, berapakah jumlah
      liter air yang dijimatkan sehari oleh semua murid? '
    QuestionOnAnswersBtn:
    - answer:
      - Perbezaan masa = 3 minit
      - 'Setiap minit = 15 liter '
      - Bilangan murid = 200
      - Semua di atas
      answeOnBtn: 3
    - answer:
      - "Darab (\xD7)"
      - "Tolak (\u2212)"
      - "Bahagi (\xF7)"
      answeOnBtn: 0
    - answer:
      - "3 \xD7 15 \xD7 200 = 9000"
      - "3 \xD7 15 \xD7 200 = 8500"
      - "3 \xD7 15 \xD7 200 = 7500"
      answeOnBtn: 0
    - answer:
      - "9000 \xF7 200 = 45 liter"
      - "9000 \xF7 3 = 3000 liter"
      - Kedua-duanya betul
      answeOnBtn: 2
    - answer:
      - 'Jumlah air yang dijimatkan ialah 9000 liter sehari. '
      - 'Jumlah air yang dijimatkan ialah 9040 liter sehari. '
      answeOnBtn: 0
  - question:
    - 'Sebuah basikal mengeluarkan 0 kg karbon dioksida manakala sebuah motosikal
      mengeluarkan 2.3 kg karbon dioksida untuk perjalanan sejauh 10 km. Berapakah
      jumlah karbon dioksida yang dijimatkan jika 50 murid berbasikal sejauh 10 km
      berbanding menaiki motosikal? '
    QuestionOnAnswersBtn:
    - answer:
      - Basikal = 0 kg
      - Motosikal = 2.3 kg
      - Bilangan murid = 50
      - Semua di atas
      answeOnBtn: 3
    - answer:
      - "Darab (\xD7)"
      - "Bahagi (\xF7)"
      - Tambah (+)
      answeOnBtn: 0
    - answer:
      - "2.3 \xD7 50 = 115 kg"
      - "2.3 \xD7 50 = 120 kg"
      - "2.3 \xD7 50 = 100 kg"
      answeOnBtn: 0
    - answer:
      - "115 \xF7 50 = 2.3"
      - "115 \u2212 2.3 = 112.7"
      - "120 \u2212 50 = 70"
      answeOnBtn: 0
    - answer:
      - 'Jumlah karbon dioksida yang dijimatkan ialah 115 kg. '
      - 'Jumlah karbon dioksida yang dijimatkan ialah 120 kg. '
      answeOnBtn: 0
  - question:
    - 'Data penggunaan internet pelajar dalam seminggu ialah 12 jam untuk pembelajaran
      dan 18 jam untuk hiburan. Jika terdapat 30 pelajar, berapakah jumlah jam penggunaan
      internet untuk pembelajaran? '
    QuestionOnAnswersBtn:
    - answer:
      - Seorang pelajar = 12 jam pembelajaran
      - Bilangan pelajar = 30
      - Kedua-dua A dan B
      answeOnBtn: 2
    - answer:
      - "Darab (\xD7)"
      - Tambah (+)
      - "Tolak (\u2212)"
      answeOnBtn: 0
    - answer:
      - "12 \xD7 30 = 360 jam"
      - "12 \xD7 30 = 300 jam"
      - "12 \xD7 30 = 330 jam"
      answeOnBtn: 1
    - answer:
      - "360 \xF7 30 = 12"
      - "360 \u2212 12 = 348"
      - 300 + 30 = 330
      answeOnBtn: 0
    - answer:
      - 'Jumlah jam penggunaan internet untuk pembelajaran ialah 360 jam. '
      - 'Jumlah jam penggunaan internet untuk pembelajaran ialah 420 jam. '
      answeOnBtn: 0
  - question:
    - 'Sebuah kantin sekolah menghasilkan 125 kg sisa makanan seminggu. Jika sisa
      itu dikompos dan digunakan semula sebagai baja, berapakah jumlah sisa makanan
      yang dapat dikitar semula dalam 4 minggu? '
    QuestionOnAnswersBtn:
    - answer:
      - Sisa mingguan = 125 kg
      - Tempoh = 4 minggu
      - 'Kedua-dua A dan B '
      answeOnBtn: 2
    - answer:
      - "Darab (\xD7)"
      - "Bahagi (\xF7)"
      - "Tolak (\u2212)"
      answeOnBtn: 0
    - answer:
      - "125 \xD7 4 = 500 kg"
      - "125 \xD7 4 = 480 kg"
      - "125 \xD7 4 = 450 kg"
      answeOnBtn: 0
    - answer:
      - "500 \xF7 4 = 125"
      - "500 \u2212 125 = 375"
      - '480 + 20 = 500 '
      answeOnBtn: 0
    - answer:
      - 'Jumlah sisa makanan yang dapat dikitar semula dalam 4 minggu ialah 500 kg. '
      - 'Jumlah sisa makanan yang dapat dikitar semula dalam 4 minggu ialah 600 kg. '
      answeOnBtn: 0
